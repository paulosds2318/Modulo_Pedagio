generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContratoLocacao {
  id              Int      @id @default(autoincrement())
  numeroContrato  String   @unique
  cpfCliente      String
  telefoneCliente String?
  placa           String
  dataRetirada    DateTime
  dataDevolucao   DateTime
  lojaRetirada    String

  @@index([placa, dataRetirada, dataDevolucao])
  @@map("contratos_locacao")
}

model PassagemPedagio {
  id              Int           @id @default(autoincrement())
  idCoral         String        @unique
  numeroContrato  String
  cpfCliente      String
  telefoneCliente String?
  placa           String
  tag             String
  praca           String
  rodovia         String
  dataHora        DateTime
  valorCentavos   Int
  lojaRetirada    String
  loteId          Int?
  lote            LoteCobranca? @relation(fields: [loteId], references: [id])

  @@index([numeroContrato])
  @@index([loteId])
  @@map("passagens_pedagio")
}

model LoteCobranca {
  id                  Int                 @id @default(autoincrement())
  numeroContrato      String
  cpfCliente          String
  telefoneCliente     String?
  quantidadePassagens Int
  valorTotalCentavos  Int
  taxaCentavos        Int                 @default(0)
  valorFinalCentavos  Int
  status              String              @default("PENDENTE")
  adyenLinkId         String?
  adyenPaymentUrl     String?
  adyenPspReference   String?
  etapaRegua          String              @default("D0")
  dataCriacao         DateTime            @default(now())
  dataPagamento       DateTime?
  d5TentativaAt       DateTime?
  d7LembreteAt        DateTime?
  d10TentativaAt      DateTime?
  processandoAte      DateTime?
  passagens           PassagemPedagio[]
  logs                LogRegua[]
  integrationJobs     IntegrationOutbox[]

  @@index([numeroContrato])
  @@index([status])
  @@map("lotes_cobranca")
}

model LogRegua {
  id                Int          @id @default(autoincrement())
  loteId            Int
  etapa             String
  acao              String
  canal             String
  resultado         String
  detalhesResposta  String?
  providerMessageId String?
  dataHora          DateTime     @default(now())
  lote              LoteCobranca @relation(fields: [loteId], references: [id])

  @@index([loteId])
  @@index([providerMessageId])
  @@map("logs_regua")
}

model IntegrationOutbox {
  id                 Int          @id @default(autoincrement())
  loteId             Int
  lote               LoteCobranca @relation(fields: [loteId], references: [id], onDelete: Cascade)
  tipo               String
  status             String       @default("PENDENTE")
  tentativas         Int          @default(0)
  proximaTentativaAt DateTime     @default(now())
  processandoAte     DateTime?
  ultimoErro         String?
  dataCriacao        DateTime     @default(now())
  atualizadoEm       DateTime     @updatedAt

  @@unique([loteId, tipo])
  @@index([status, proximaTentativaAt])
  @@map("integration_outbox")
}

// =========================================================================
// Better Auth - Autenticação & Perfis (Admin e Visualização)
// =========================================================================

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Plugin Admin / RBAC: perfis "admin" ou "viewer" (visualizacao)
  role       String?   @default("viewer")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}
